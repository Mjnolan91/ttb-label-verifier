# Cross-platform line endings.
# Normalize text files to LF in the repository and on checkout, so shell scripts and
# config stay consistent across Windows/macOS/Linux checkouts.
* text=auto eol=lf

# Shell scripts MUST be LF regardless of platform.
*.sh text eol=lf

# Future real label images (replacing the SVG placeholders) are binary.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
