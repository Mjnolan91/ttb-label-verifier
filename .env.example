# TTB Label Verifier — environment variables (ALL OPTIONAL)
#
# The app AND the entire test suite run in MOCK mode with NONE of these set:
#     npm install && npm run dev      # http://localhost:3000 — no keys, no network
#
# Real extraction is opt-in and runs IN-TENANT on Azure (the firewall-survival story:
# in-tenant Azure services aren't the third-party ML endpoints the outbound firewall blocks).
# Copy this file to `.env.local` and fill in only what you need. NEVER commit real secrets.

# Which extractor the verify path uses. Default: mock.
#   mock     — offline, keys-free (default)
#   llm      — Azure OpenAI (multimodal)              → requires the AZURE_OPENAI_* vars below
#   ocr      — Azure AI Document Intelligence (OCR)   → requires the AZURE_DOCUMENT_INTELLIGENCE_* vars
#   openai   — OpenAI API directly (api.openai.com)   → requires OPENAI_API_KEY (no Azure resource/quota)
#   gemini   — Google Gemini directly                 → requires GEMINI_API_KEY (or GOOGLE_API_KEY)
#   ensemble — run llm + ocr in parallel and reconcile disagreements → requires BOTH sets
# VISION_PROVIDER=mock

# Per-call extraction timeout in ms (optional). Unset = ~3s for the mock, ~8s for real providers
# (a straggler cap, not the ~5s result budget — a single Azure-vision call returns well under it).
# VISION_TIMEOUT_MS=8000

# --- OpenAI  (only needed when VISION_PROVIDER=openai) — the no-Azure-resource demo path ---
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4.1                         # optional (default; gpt-4.1-mini is cheaper/faster)

# --- Google Gemini  (only needed when VISION_PROVIDER=gemini) — another no-Azure-resource demo path ---
# GEMINI_API_KEY=...                           # or GOOGLE_API_KEY; from https://aistudio.google.com/apikey
# GEMINI_MODEL=gemini-3.1-pro-preview          # default (pro; reads subtle cues like bold best). gemini-3.5-flash is cheaper/faster.
# SELF_CONSISTENCY_SAMPLES=3                    # real-provider reads sampled N x in parallel; agreement becomes the field confidence. 1 disables.

# --- Azure OpenAI  (only needed when VISION_PROVIDER=llm or ensemble) ---
# AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=<key>
# AZURE_OPENAI_DEPLOYMENT=<your-vision-capable-deployment-name>
# AZURE_OPENAI_API_VERSION=2024-10-21        # optional (this is the default)

# --- Azure AI Document Intelligence  (only needed when VISION_PROVIDER=ocr or ensemble) ---
# AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com
# AZURE_DOCUMENT_INTELLIGENCE_KEY=<key>
# AZURE_DOCUMENT_INTELLIGENCE_API_VERSION=2024-11-30   # optional (this is the default)
# AZURE_DOCUMENT_INTELLIGENCE_MODEL=prebuilt-read      # optional (this is the default)

# Note: if a selected provider's required vars are unset, it fails with a clear, actionable
# message — and the absence of Azure keys never affects the default (mock) dev/test path.
